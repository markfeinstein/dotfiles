#!/usr/bin/env bash

set -euo pipefail

source_app=
primary_user=
primary_home=
comparator=
destination=/Applications/Yabai.app
bundle_identifier=com.asmvik.yabai
transaction_root=/Applications/.Yabai.app.activation.lock
restart_marker=/var/run/yabai-app-install-restart-required

usage() {
  echo "usage: install-yabai-app --source-app PATH --primary-user USER --primary-home PATH --comparator PATH" >&2
  exit 64
}

while (($#)); do
  case "$1" in
  --source-app)
    (($# >= 2)) || usage
    source_app=$2
    shift 2
    ;;
  --primary-user)
    (($# >= 2)) || usage
    primary_user=$2
    shift 2
    ;;
  --primary-home)
    (($# >= 2)) || usage
    primary_home=$2
    shift 2
    ;;
  --comparator)
    (($# >= 2)) || usage
    comparator=$2
    shift 2
    ;;
  *) usage ;;
  esac
done

[[ $source_app == /* && -n $primary_user && $primary_home == /* && $comparator == /* ]] || usage

source_manifest="$source_app/Contents/Resources/content-manifest.sha256"
rollback_app="$transaction_root/rollback/Yabai.app"
quarantine_app="$transaction_root/quarantine/Yabai.app"
committed=0
destination_initially_absent=0

as_primary_user() {
  launchctl asuser "$(id -u "$primary_user")" sudo -u "$primary_user" -- "$@"
}

# Called indirectly from the EXIT cleanup handler.
# shellcheck disable=SC2329
guarded_delete_transaction() {
  if [[ $transaction_root != /Applications/.Yabai.app.activation.lock || ! -d $transaction_root || -L $transaction_root ]]; then
    echo "refusing to remove unguarded yabai transaction root: $transaction_root" >&2
    return 1
  fi
  owner="$(/usr/bin/stat -f '%u:%g' "$transaction_root")" || return 1
  if [[ $owner != 0:0 ]]; then
    echo "refusing to remove yabai transaction root not owned by root:wheel" >&2
    return 1
  fi
  /usr/bin/find "$transaction_root" -depth -delete
}

# Installed below as the transaction's EXIT trap.
# shellcheck disable=SC2329
cleanup_transaction() {
  status=$?
  trap - EXIT HUP INT TERM
  preserve=0
  if ((committed == 0)) && [[ -d $rollback_app && ! -L $rollback_app ]]; then
    if [[ -e $destination || -L $destination ]]; then
      /bin/mv "$destination" "$transaction_root/quarantine/failed-Yabai.app" || preserve=1
    fi
    if ((preserve == 0)); then
      /bin/mv "$rollback_app" "$destination" || preserve=1
    fi
  elif ((committed == 0 && destination_initially_absent == 1)) && [[ ! -e $quarantine_app && (-e $destination || -L $destination) ]]; then
    /bin/mv "$destination" "$transaction_root/quarantine/failed-Yabai.app" || preserve=1
  fi
  if ((preserve == 0)); then
    if ! guarded_delete_transaction; then
      echo "yabai transaction cleanup failed; artifact retained at $transaction_root" >&2
      ((status != 0)) || status=1
    fi
  else
    echo "yabai rollback is uncertain; artifact retained at $transaction_root" >&2
    ((status != 0)) || status=1
  fi
  exit "$status"
}

umask 077
if ! /bin/mkdir "$transaction_root"; then
  echo "refusing concurrent or stale Yabai.app transaction lock: $transaction_root" >&2
  exit 1
fi
trap cleanup_transaction EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
/bin/chmod 0711 "$transaction_root"
/usr/sbin/chown root:wheel "$transaction_root"
if [[ ! -e $destination && ! -L $destination ]]; then
  destination_initially_absent=1
fi

/bin/mkdir "$transaction_root/signing" "$transaction_root/quarantine" "$transaction_root/rollback"
/bin/chmod 0700 "$transaction_root/signing" "$transaction_root/quarantine" "$transaction_root/rollback"
/usr/sbin/chown "$primary_user:staff" "$transaction_root/signing"

identities="$(
  as_primary_user /usr/bin/env HOME="$primary_home" USER="$primary_user" LOGNAME="$primary_user" \
    /usr/bin/security find-identity -v -p codesigning "$primary_home/Library/Keychains/login.keychain-db" \
    | /usr/bin/sed -nE 's/^[[:space:]]*[0-9]+\) ([0-9A-Fa-f]{40}) "yabai-cert"$/\1/p'
)"
identity_count="$(printf '%s\n' "$identities" | /usr/bin/awk 'NF { count++ } END { print count + 0 }')"
if [[ $identity_count -ne 1 ]]; then
  echo "expected exactly one valid yabai-cert signing identity; found $identity_count" >&2
  exit 1
fi
identity="$(printf '%s\n' "$identities" | /usr/bin/tr '[:lower:]' '[:upper:]')"
requirement="identifier \"$bundle_identifier\" and certificate leaf = H\"$identity\""

verify_exact_tree() {
  local candidate=$1
  [[ -d $candidate && ! -L $candidate ]] || return 1
  [[ -z $(/usr/bin/find "$candidate" -type l -print) ]] || return 1
  actual_tree="$(cd "$candidate" && /usr/bin/find . -mindepth 1 -print | LC_ALL=C /usr/bin/sort)" || return 1
  expected_tree="$(printf '%s\n' \
    ./Contents \
    ./Contents/Info.plist \
    ./Contents/MacOS \
    ./Contents/MacOS/yabai \
    ./Contents/Resources \
    ./Contents/Resources/content-manifest.sha256 \
    ./Contents/_CodeSignature \
    ./Contents/_CodeSignature/CodeResources | LC_ALL=C /usr/bin/sort)"
  [[ $actual_tree == "$expected_tree" ]]
}

verify_root_metadata() {
  local candidate=$1
  /usr/bin/find "$candidate" -exec /usr/bin/stat -f '%u:%g:%OLp' {} \; \
    | /usr/bin/awk -F: '
      $1 != 0 || $2 != 0 { bad = 1 }
      {
        group = int($3 / 10) % 10
        other = $3 % 10
        if (group == 2 || group == 3 || group == 6 || group == 7 ||
            other == 2 || other == 3 || other == 6 || other == 7) bad = 1
      }
      END { exit bad }
    ' || return 1
  while IFS= read -r path; do
    acl_listing="$(/bin/ls -lde "$path")" || return 1
    mode_field="$(printf '%s\n' "$acl_listing" | /usr/bin/sed -n '1{s/[[:space:]].*//;p;}')"
    case "$mode_field" in *+) return 1 ;; esac
    [[ -z $(printf '%s\n' "$acl_listing" | /usr/bin/sed -n '2,$p') ]] || return 1
    [[ $(/usr/bin/stat -f '%f' "$path") == 0 ]] || return 1
    xattrs="$(/usr/bin/xattr "$path")" || return 1
    # Current macOS may attach protected provenance across copied bundle
    # directories; it is not writable ACL state, but no other xattr is allowed.
    [[ -z $xattrs || $xattrs == com.apple.provenance ]] || return 1
  done < <(/usr/bin/find "$candidate" -print)
  for directory in \
    "$candidate" \
    "$candidate/Contents" \
    "$candidate/Contents/MacOS" \
    "$candidate/Contents/Resources" \
    "$candidate/Contents/_CodeSignature"; do
    [[ $(/usr/bin/stat -f '%OLp' "$directory") == 755 ]] || return 1
  done
  [[ $(/usr/bin/stat -f '%OLp' "$candidate/Contents/MacOS/yabai") == 755 ]] || return 1
  for file in \
    "$candidate/Contents/Info.plist" \
    "$candidate/Contents/Resources/content-manifest.sha256" \
    "$candidate/Contents/_CodeSignature/CodeResources"; do
    [[ $(/usr/bin/stat -f '%OLp' "$file") == 644 ]] || return 1
  done
}

verify_source_content() {
  local candidate=$1
  source_content_scratch="$(/usr/bin/mktemp -d "$transaction_root/normalize.XXXXXX")" || return 1
  /bin/mkdir -p "$source_content_scratch/Contents/MacOS" "$source_content_scratch/Contents/Resources" || return 1
  /usr/bin/install -m 0700 "$candidate/Contents/MacOS/yabai" "$source_content_scratch/Contents/MacOS/yabai.signed" || return 1
  /usr/bin/install -m 0600 "$candidate/Contents/Info.plist" "$source_content_scratch/Contents/Info.plist" || return 1
  /usr/bin/install -m 0600 "$candidate/Contents/Resources/content-manifest.sha256" \
    "$source_content_scratch/Contents/Resources/content-manifest.sha256" || return 1
  /usr/bin/cmp -s "$source_manifest" "$source_content_scratch/Contents/Resources/content-manifest.sha256" || return 1
  source_content_plist_manifest="$(/usr/bin/grep -E '^[0-9a-f]{64}  Contents/Info\.plist$' "$source_manifest")" || return 1
  [[ $(printf '%s\n' "$source_content_plist_manifest" | /usr/bin/awk 'NF { count++ } END { print count + 0 }') -eq 1 ]] || return 1
  (cd "$source_content_scratch" && printf '%s\n' "$source_content_plist_manifest" | sha256sum -c - >&2) || return 1
  /bin/cp "$source_content_scratch/Contents/MacOS/yabai.signed" "$source_content_scratch/Contents/MacOS/yabai.removed" || return 1
  /usr/bin/codesign --remove-signature "$source_content_scratch/Contents/MacOS/yabai.removed" || return 1
  python3 "$comparator" \
    "$source_app/Contents/MacOS/yabai" \
    "$source_content_scratch/Contents/MacOS/yabai.signed" \
    "$source_content_scratch/Contents/MacOS/yabai.removed"
}

displayed_requirement_matches() {
  local candidate=$1
  displayed_requirement_output="$(/usr/bin/codesign -d -r- "$candidate" 2>&1)" || return 1
  displayed_designated="$(printf '%s\n' "$displayed_requirement_output" | /usr/bin/sed -n '/^designated => /p')"
  [[ $(printf '%s\n' "$displayed_designated" | /usr/bin/awk 'NF { count++ } END { print count + 0 }') -eq 1 ]] || return 1
  displayed_normalized="$(printf '%s' "$displayed_designated" | /usr/bin/tr '[:upper:]' '[:lower:]')"
  displayed_expected="designated => identifier \"$bundle_identifier\" and certificate leaf = h\"$(printf '%s' "$identity" | /usr/bin/tr '[:upper:]' '[:lower:]')\""
  [[ $displayed_normalized == "$displayed_expected" ]]
}

verify_signed() {
  local signed_candidate=$1
  verify_exact_tree "$signed_candidate" \
    && verify_root_metadata "$signed_candidate" \
    && /usr/bin/codesign --verify --strict --deep --test-requirement "=$requirement" "$signed_candidate" \
    && /usr/bin/codesign --verify --strict --test-requirement "=$requirement" "$signed_candidate/Contents/MacOS/yabai" \
    && displayed_requirement_matches "$signed_candidate" \
    && displayed_requirement_matches "$signed_candidate/Contents/MacOS/yabai" \
    && verify_source_content "$signed_candidate"
}

if verify_signed "$destination"; then
  echo "Yabai.app already has the current content, ownership, and signing identity" >&2
  printf 'no-op\n'
  exit 0
fi

as_primary_user /usr/bin/env HOME="$primary_home" USER="$primary_user" LOGNAME="$primary_user" \
  /usr/bin/ditto "$source_app" "$transaction_root/signing/Yabai.app"
signing_app="$transaction_root/signing/Yabai.app"
/bin/chmod -R u+w "$signing_app"
[[ -z $(/usr/bin/find "$signing_app" -type l -print) ]]
(
  cd "$signing_app"
  sha256sum -c "$source_manifest" >&2
)
as_primary_user /usr/bin/env HOME="$primary_home" USER="$primary_user" LOGNAME="$primary_user" \
  /usr/bin/codesign --force --sign "$identity" --identifier "$bundle_identifier" \
  --requirements "=designated => $requirement" --timestamp=none "$signing_app"
/bin/chmod 0644 "$signing_app/Contents/_CodeSignature/CodeResources"

/bin/chmod 0700 "$transaction_root"
/usr/bin/ditto --noacl --noextattr --noqtn --norsrc "$signing_app" "$quarantine_app"
/usr/bin/chflags -R 0 "$quarantine_app"
/bin/chmod -RN "$quarantine_app"
/usr/bin/xattr -cr "$quarantine_app" 2>/dev/null || true
/usr/sbin/chown -R root:wheel "$quarantine_app"
/bin/chmod -R go-w "$quarantine_app"
verify_signed "$quarantine_app"

if [[ -e $destination || -L $destination ]]; then
  if [[ ! -d $destination || -L $destination ]]; then
    echo "refusing to replace non-directory $destination" >&2
    exit 1
  fi
  /bin/mv "$destination" "$rollback_app"
fi
/bin/mv "$quarantine_app" "$destination"
verify_signed "$destination"
if [[ -e $restart_marker || -L $restart_marker ]]; then
  [[ -f $restart_marker && ! -L $restart_marker && $(/usr/bin/stat -f '%u:%g' "$restart_marker") == 0:0 ]] || exit 1
fi
/usr/bin/install -o root -g wheel -m 0600 /dev/null "$restart_marker"
[[ $(/usr/bin/stat -f '%u:%g:%OLp' "$restart_marker") == 0:0:600 ]]
committed=1
printf 'changed\n'
