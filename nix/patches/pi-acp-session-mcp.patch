diff -ruN --exclude=node_modules --exclude=dist --exclude=AGENTS.md a/src/session-mcp-extension.ts b/src/session-mcp-extension.ts
--- a/src/session-mcp-extension.ts	1969-12-31 16:00:00
+++ b/src/session-mcp-extension.ts	2026-11-01 11:17:40
@@ -0,0 +1,15 @@
+import { SESSION_MCP_SERVERS_ENV, type PiMcpServerRegistration } from './pi-rpc/mcp-servers.js'
+
+type ExtensionApi = {
+  registerMcpServer(name: string, config: PiMcpServerRegistration['config']): void
+}
+
+export default function registerSessionMcpServers(pi: ExtensionApi): void {
+  const encoded = process.env[SESSION_MCP_SERVERS_ENV]
+  if (!encoded) return
+
+  const registrations = JSON.parse(encoded) as PiMcpServerRegistration[]
+  for (const registration of registrations) {
+    pi.registerMcpServer(registration.name, registration.config)
+  }
+}
