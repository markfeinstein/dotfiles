diff -ruN --exclude=node_modules --exclude=dist --exclude=AGENTS.md a/src/pi-rpc/mcp-servers.ts b/src/pi-rpc/mcp-servers.ts
--- a/src/pi-rpc/mcp-servers.ts	1969-12-31 16:00:00
+++ b/src/pi-rpc/mcp-servers.ts	2026-11-01 11:19:13
@@ -0,0 +1,73 @@
+import type { McpServer } from '@agentclientprotocol/sdk'
+
+export const SESSION_MCP_SERVERS_ENV = 'PI_ACP_SESSION_MCP_SERVERS'
+
+export type PiMcpServerConfig = {
+  command?: string
+  args?: string[]
+  env?: Record<string, string>
+  url?: string
+  headers?: Record<string, string>
+  exposure: 'direct'
+}
+
+export type PiMcpServerRegistration = {
+  name: string
+  config: PiMcpServerConfig
+}
+
+export class PiRpcMcpServerError extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = 'PiRpcMcpServerError'
+  }
+}
+
+function safeServerName(name: string, index: number, used: Set<string>): string {
+  const normalized = name.replace(/[^A-Za-z0-9_-]+/g, '-').replace(/^-+|-+$/g, '') || `acp-${index + 1}`
+  let candidate = normalized
+  let suffix = 2
+
+  while (used.has(candidate.replaceAll('-', '_'))) {
+    candidate = `${normalized}-${suffix}`
+    suffix += 1
+  }
+
+  used.add(candidate.replaceAll('-', '_'))
+  return candidate
+}
+
+export function toPiMcpServerRegistrations(servers: McpServer[]): PiMcpServerRegistration[] {
+  const usedNames = new Set<string>()
+
+  return servers.map((server, index) => {
+    const name = safeServerName(server.name, index, usedNames)
+
+    if ('command' in server) {
+      return {
+        name,
+        config: {
+          command: server.command,
+          args: server.args,
+          env: Object.fromEntries(server.env.map(variable => [variable.name, variable.value])),
+          exposure: 'direct'
+        }
+      }
+    }
+
+    if (server.type === 'http') {
+      return {
+        name,
+        config: {
+          url: server.url,
+          headers: Object.fromEntries(server.headers.map(header => [header.name, header.value])),
+          exposure: 'direct'
+        }
+      }
+    }
+
+    throw new PiRpcMcpServerError(
+      `Unsupported ACP MCP transport for server ${JSON.stringify(server.name)}: ${server.type}`
+    )
+  })
+}
