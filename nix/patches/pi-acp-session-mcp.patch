+import test from 'node:test'
+import assert from 'node:assert/strict'
+import type { McpServer } from '@agentclientprotocol/sdk'
+import registerSessionMcpServers from '../../src/session-mcp-extension.js'
+import {
+  PiRpcMcpServerError,
+  SESSION_MCP_SERVERS_ENV,
+  toPiMcpServerRegistrations
+} from '../../src/pi-rpc/mcp-servers.js'
+
+test('toPiMcpServerRegistrations converts stdio and HTTP servers for Pi', () => {
+  const registrations = toPiMcpServerRegistrations([
+    {
+      name: 'SolidCraft app',
+      command: '/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli',
+      args: ['mcp', '--connect', '127.0.0.1:27878'],
+      env: [
+        { name: 'FIRST', value: 'one' },
+        { name: 'SECOND', value: 'two' }
+      ]
+    },
+    {
+      type: 'http',
+      name: 'docs',
+      url: 'https://example.invalid/mcp',
+      headers: [{ name: 'Authorization', value: 'Bearer test' }]
+    }
+  ] as McpServer[])
+
+  assert.deepEqual(registrations, [
+    {
+      name: 'SolidCraft-app',
+      config: {
+        command: '/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli',
+        args: ['mcp', '--connect', '127.0.0.1:27878'],
+        env: { FIRST: 'one', SECOND: 'two' },
+        exposure: 'direct'
+      }
+    },
+    {
+      name: 'docs',
+      config: {
+        url: 'https://example.invalid/mcp',
+        headers: { Authorization: 'Bearer test' },
+        exposure: 'direct'
+      }
+    }
+  ])
+})
+
+test('toPiMcpServerRegistrations produces distinct Pi-safe names', () => {
+  const registrations = toPiMcpServerRegistrations([
+    { name: 'same-name', command: 'one', args: [], env: [] },
+    { name: 'same_name', command: 'two', args: [], env: [] },
+    { name: '***', command: 'three', args: [], env: [] }
+  ])
+
+  assert.deepEqual(
+    registrations.map(registration => registration.name),
+    ['same-name', 'same_name-2', 'acp-3']
+  )
+})
+
+test('toPiMcpServerRegistrations rejects unsupported transports', () => {
+  assert.throws(
+    () =>
+      toPiMcpServerRegistrations([{ type: 'sse', name: 'legacy', url: 'https://example.invalid/sse', headers: [] }]),
+    (error: unknown) => error instanceof PiRpcMcpServerError && error.message.includes('legacy')
+  )
+})
+
+test('session MCP extension registers serialized servers', () => {
+  const previous = process.env[SESSION_MCP_SERVERS_ENV]
+  const registered: unknown[] = []
+  process.env[SESSION_MCP_SERVERS_ENV] = JSON.stringify([
+    {
+      name: 'solidcraft-app',
+      config: { command: '/tmp/solidcraft-cli', args: ['mcp'], env: {}, exposure: 'direct' }
+    }
+  ])
+
+  try {
+    registerSessionMcpServers({
+      registerMcpServer(name, config) {
+        registered.push({ name, config })
+      }
+    })
+  } finally {
+    if (previous === undefined) delete process.env[SESSION_MCP_SERVERS_ENV]
+    else process.env[SESSION_MCP_SERVERS_ENV] = previous
+  }
+
+  assert.deepEqual(registered, [
+    {
+      name: 'solidcraft-app',
+      config: { command: '/tmp/solidcraft-cli', args: ['mcp'], env: {}, exposure: 'direct' }
+    }
+  ])
+})
diff -ruN --exclude=node_modules --exclude=dist --exclude=AGENTS.md a/test/unit/pi-rpc-mcp-servers.test.ts b/test/unit/pi-rpc-mcp-servers.test.ts
--- a/test/unit/pi-rpc-mcp-servers.test.ts	1969-12-31 16:00:00
+++ b/test/unit/pi-rpc-mcp-servers.test.ts	2026-11-01 11:19:13
@@ -0,0 +1,78 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { chmodSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { SESSION_MCP_SERVERS_ENV } from '../../src/pi-rpc/mcp-servers.js'
+
+function writeFakePi(root: string): string {
+  const launcher = join(root, 'pi')
+  writeFileSync(
+    launcher,
+    [
+      '#!/usr/bin/env node',
+      "const { writeFileSync } = require('node:fs')",
+      "const readline = require('node:readline')",
+      'writeFileSync(process.env.PI_ACP_MCP_TEST_LOG, JSON.stringify({ args: process.argv.slice(2), servers: process.env.PI_ACP_SESSION_MCP_SERVERS ?? null }))',
+      "readline.createInterface({ input: process.stdin }).on('line', line => {",
+      '  const command = JSON.parse(line)',
+      "  process.stdout.write(JSON.stringify({ type: 'response', id: command.id, command: command.type, success: true, data: {} }) + '\\n')",
+      '})'
+    ].join('\n')
+  )
+  chmodSync(launcher, 0o755)
+  return launcher
+}
+
+test('PiRpcProcess passes ACP MCP servers through the session extension', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-'))
+  const launcher = writeFakePi(root)
+  const log = join(root, 'launch.json')
+  const extension = join(root, 'session-mcp-extension.js')
+  const previousLog = process.env.PI_ACP_MCP_TEST_LOG
+  const previousExtension = process.env.PI_ACP_MCP_EXTENSION_PATH
+  const previousServers = process.env[SESSION_MCP_SERVERS_ENV]
+  process.env.PI_ACP_MCP_TEST_LOG = log
+  process.env.PI_ACP_MCP_EXTENSION_PATH = extension
+  process.env[SESSION_MCP_SERVERS_ENV] = 'stale-parent-value'
+
+  try {
+    const proc = await PiRpcProcess.spawn({
+      cwd: root,
+      piCommand: launcher,
+      mcpServers: [
+        {
+          name: 'solidcraft-app',
+          command: '/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli',
+          args: ['mcp'],
+          env: [{ name: 'SOLIDCRAFT_CONTROL_PORT', value: '27878' }]
+        }
+      ]
+    })
+    proc.dispose()
+
+    const launch = JSON.parse(readFileSync(log, 'utf8'))
+    assert.deepEqual(launch.args, ['--mode', 'rpc', '--no-themes', '--extension', extension])
+    assert.deepEqual(JSON.parse(launch.servers), [
+      {
+        name: 'solidcraft-app',
+        config: {
+          command: '/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli',
+          args: ['mcp'],
+          env: { SOLIDCRAFT_CONTROL_PORT: '27878' },
+          exposure: 'direct'
+        }
+      }
+    ])
+  } finally {
+    if (previousLog === undefined) delete process.env.PI_ACP_MCP_TEST_LOG
+    else process.env.PI_ACP_MCP_TEST_LOG = previousLog
+    if (previousExtension === undefined) delete process.env.PI_ACP_MCP_EXTENSION_PATH
+    else process.env.PI_ACP_MCP_EXTENSION_PATH = previousExtension
+    if (previousServers === undefined) delete process.env[SESSION_MCP_SERVERS_ENV]
+    else process.env[SESSION_MCP_SERVERS_ENV] = previousServers
+    await new Promise(resolve => setTimeout(resolve, 30))
+    rmSync(root, { recursive: true, force: true })
+  }
+})
