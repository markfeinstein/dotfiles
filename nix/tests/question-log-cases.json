    "time": "09:00",
    "expected": ["## Activity", "- **09:00** - first", "- [09:00] second", "- **09:00** - third", "- **10:00** - later"]
  },
  {
    "name": "ignores timestamps inside fenced examples",
    "heading": "## Activity",
    "input": ["## Activity", "```markdown", "- **23:59** - example", "```", "- **10:00** - later"],
    "text": "middle",
    "time": "09:00",
    "expected": ["## Activity", "```markdown", "- **23:59** - example", "```", "- **09:00** - middle", "- **10:00** - later"]
  },
  {
    "name": "preserves untimed history and nested bullets",
