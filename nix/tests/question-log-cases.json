    "text": "middle",
    "time": "09:00",
    "expected": ["## Activity", "", "- 08:00 Earlier", "  detail", "- **09:00** - middle", "- **10:00** Later"]
  },
  {
    "name": "keeps equal timestamps stable",
    "heading": "## Activity",
