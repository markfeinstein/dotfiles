[
  {
    "name": "creates configured heading",
    "heading": "## Activity",
    "input": ["# Daily", "intro"],
    "text": "new entry",
    "time": "09:30",
    "expected": ["# Daily", "intro", "", "## Activity", "", "- **09:30** - new entry"]
  },
  {
    "name": "reuses empty placeholder",
    "heading": "## Activity",
    "input": ["## Activity", "", "- ", "", "> [!tip] Keep this"],
    "text": "new entry",
    "time": "09:30",
    "expected": ["## Activity", "", "- **09:30** - new entry", "", "> [!tip] Keep this"]
  },
  {
    "name": "recognizes legacy timestamps and preserves nested details",
