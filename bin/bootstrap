#!/bin/sh
set -eu

profile=
profile_from_flag=0
host=
host_from_override=0
flake=${DOTFILES_FLAKE:-}
default_flake=github:markfeinstein/dotfiles/main
personal_flake=${DOTFILES_PERSONAL_FLAKE:-$default_flake}
work_flake=${DOTFILES_WORK_FLAKE:-$default_flake}
profile_file=${DOTFILES_PROFILE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/profile}
auth_github=0
tmp_dir=
profile_tmp=
clt_marker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
clt_marker_created=0
determinate_installer_version=3.24.2
determinate_installer_aarch64_linux_sha256=bc18d8d8ca12f95d219b5978201e15d0049b2e9d8b7c49593f26503c87172145
determinate_installer_x86_64_linux_sha256=22ed14ee1b24d100d388f1fc245e3062bd5982433d159cffa6dec34c0eb15dab

usage() {
  cat <<'HELP'
Usage: bootstrap [--profile personal|work] [--host NAME] [--flake REF] [--auth-github]

Configure a new machine without Git, Homebrew, or a local checkout.
Installs Determinate Nix when Nix is absent, then activates the selected profile.

Profile precedence:
  --profile, DOTFILES_PROFILE, persisted profile, interactive prompt

Darwin configuration selection:
  --host or DOTFILES_HOST selects an exact output. Otherwise bootstrap tries
  the macOS LocalHostName, then hostname -s, and falls back to the profile name.

Remote source precedence:
  --flake or DOTFILES_FLAKE, the selected profile's default flake, then
  github:markfeinstein/dotfiles/main

Environment:
  DOTFILES_PROFILE          temporary profile override
  DOTFILES_PROFILE_FILE     persisted profile path
  DOTFILES_HOST             Darwin host output override
  DOTFILES_FLAKE            one-run flake override
  DOTFILES_PERSONAL_FLAKE   default personal flake
  DOTFILES_WORK_FLAKE       default work flake

macOS flakes must export darwinConfigurations.<host> or a profile fallback.
Linux flakes must export homeConfigurations.<system>-<profile>.
HELP
}

fail() { printf 'bootstrap: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }

persist_dotfiles_profile() {
  profile_dir=$(dirname "$profile_file")
  umask 077
  mkdir -p "$profile_dir" || fail "could not create profile directory: $profile_dir"
  profile_tmp=$(mktemp "$profile_dir/profile.tmp.XXXXXX") || fail 'could not create profile temp file'
  printf '%s\n' "$profile" >"$profile_tmp"
  chmod 600 "$profile_tmp"
  mv -f "$profile_tmp" "$profile_file"
  profile_tmp=
}

select_dotfiles_profile() {
  persist_profile=0
  if [ -z "$profile" ] && [ -n "${DOTFILES_PROFILE:-}" ]; then
    profile=$DOTFILES_PROFILE
  elif [ -z "$profile" ] && [ -f "$profile_file" ]; then
    IFS= read -r profile <"$profile_file" || fail "could not read persisted profile: $profile_file"
  elif [ -z "$profile" ]; then
    [ -r /dev/tty ] || fail 'pass --profile, set DOTFILES_PROFILE, or create the persisted profile file'
    printf 'Select profile: 1) personal  2) work\nSelection: ' >/dev/tty
    IFS= read -r answer </dev/tty || fail 'could not read profile'
    case $answer in
      1|personal) profile=personal ;;
      2|work) profile=work ;;
      *) fail 'invalid profile' ;;
    esac
    persist_profile=1
  fi

  case $profile in
    personal|work) ;;
    *) fail "invalid profile: $profile" ;;
  esac
  [ "$profile_from_flag" -eq 0 ] || persist_profile=1
  [ "$persist_profile" -eq 0 ] || persist_dotfiles_profile
}

resolve_dotfiles_system() {
  case $(uname -s) in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) fail 'unsupported OS (macOS and Linux only)' ;;
  esac
  case $(uname -m) in
    arm64|aarch64) arch=aarch64 ;;
    x86_64|amd64) arch=x86_64 ;;
    *) fail 'unsupported CPU architecture' ;;
  esac
  system="${arch}-${os}"
}

resolve_dotfiles_host() {
  if [ "$os" != darwin ]; then
    [ -z "$host" ] && [ -z "${DOTFILES_HOST:-}" ] || fail '--host and DOTFILES_HOST are supported only on macOS'
    return
  fi

  if [ -z "$host" ] && [ -n "${DOTFILES_HOST:-}" ]; then
    host=$DOTFILES_HOST
    host_from_override=1
  fi
  if [ -z "$host" ] && command -v scutil >/dev/null 2>&1; then
    host=$(scutil --get LocalHostName 2>/dev/null || true)
  fi
  if [ -z "$host" ]; then
    host=$(hostname -s 2>/dev/null || true)
  fi

  case $host in
    ''|*[!A-Za-z0-9._-]*) fail "invalid Darwin host configuration name: ${host:-empty}" ;;
  esac
}

has_darwin_command_line_tools() {
  [ -d "$(/usr/bin/xcode-select --print-path 2>/dev/null)" ] || return 1
  /usr/bin/xcrun --sdk macosx --find clang >/dev/null 2>&1 || return 1
  /usr/bin/xcrun --sdk macosx --show-sdk-path >/dev/null 2>&1
}

install_darwin_command_line_tools() {
  if [ -d /Library/Developer/CommandLineTools ]; then
    log 'Selecting the installed Apple Command Line Tools'
    sudo /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools || \
      fail 'could not select the installed Apple Command Line Tools'
    has_darwin_command_line_tools && return
  fi

  if [ ! -e "$clt_marker" ] && [ ! -L "$clt_marker" ]; then
    (umask 077; set -C; : >"$clt_marker") || fail 'could not request the Apple Command Line Tools update'
    clt_marker_created=1
  fi

  log 'Finding the Apple Command Line Tools update'
  available_updates=$(/usr/sbin/softwareupdate --list 2>&1) || \
    fail 'could not list available Apple software updates'
  clt_label=$(printf '%s\n' "$available_updates" | awk '
    /^[[:space:]]*\* Label: Command Line Tools for Xcode/ {
      sub(/^[[:space:]]*\* Label: /, "")
      label = $0
    }
    /^[[:space:]]*\* Command Line Tools for Xcode/ {
      sub(/^[[:space:]]*\* /, "")
      label = $0
    }
    END { print label }
  ')
  [ -n "$clt_label" ] || \
    fail 'no Apple Command Line Tools update is available; run xcode-select --install and rerun bootstrap'

  log "Installing $clt_label (administrator approval required)"
  sudo /usr/sbin/softwareupdate --install "$clt_label" --agree-to-license --verbose || \
    fail 'Apple Command Line Tools installation failed'
  sudo /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools || \
    fail 'could not select the installed Apple Command Line Tools'
  has_darwin_command_line_tools || fail 'Apple Command Line Tools are installed but unusable'
}

ensure_darwin_command_line_tools() {
  [ "$os" = darwin ] || return
  has_darwin_command_line_tools || install_darwin_command_line_tools
}

has_darwin_configuration() {
  wanted_configuration=$1
  while IFS= read -r available_configuration; do
    [ "$available_configuration" = "$wanted_configuration" ] && return 0
  done <<EOF
$darwin_configurations
EOF
  return 1
}

select_darwin_configuration() {
  host_configuration_profile=
  darwin_configurations=$(nix eval --refresh --raw "${flake}#darwinConfigurations" \
    --apply 'configs: builtins.concatStringsSep "\n" (builtins.attrNames configs)') || \
    fail 'could not list nix-darwin configurations'

  if has_darwin_configuration "$host"; then
    host_configuration_profile=$(nix eval --refresh --raw \
      "${flake}#darwinConfigurations.\"${host}\".config.profile.name") || \
      fail "could not evaluate darwinConfigurations.$host profile"
    if [ "$host_configuration_profile" = "$profile" ]; then
      darwin_configuration=$host
      return
    fi
    if [ "$host_from_override" -eq 1 ]; then
      fail "darwinConfigurations.$host selects the '$host_configuration_profile' profile, not '$profile'"
    fi
  elif [ "$host_from_override" -eq 1 ]; then
    fail "flake does not export darwinConfigurations.$host"
  fi

  if has_darwin_configuration "$profile"; then
    darwin_configuration=$profile
    if [ -n "${host_configuration_profile:-}" ]; then
      log "Host '$host' selects the '$host_configuration_profile' profile; using the '$profile' profile configuration"
    else
      log "No configuration for host '$host'; using the '$profile' profile configuration"
    fi
  else
    fail "flake does not export a '$profile' configuration for host '$host' or profile fallback"
  fi
}

cleanup() {
  [ -z "$tmp_dir" ] || rm -rf "$tmp_dir"
  [ -z "$profile_tmp" ] || rm -f "$profile_tmp"
  [ "$clt_marker_created" -eq 0 ] || rm -f "$clt_marker"
}
trap cleanup 0

while [ "$#" -gt 0 ]; do
  case $1 in
    --profile) [ "$#" -ge 2 ] || fail '--profile requires a value'; profile=$2; profile_from_flag=1; shift 2 ;;
    --profile=*) profile=${1#*=}; profile_from_flag=1; shift ;;
    --host) [ "$#" -ge 2 ] || fail '--host requires a value'; host=$2; host_from_override=1; shift 2 ;;
    --host=*) host=${1#*=}; host_from_override=1; shift ;;
    --flake) [ "$#" -ge 2 ] || fail '--flake requires a value'; flake=$2; shift 2 ;;
    --flake=*) flake=${1#*=}; shift ;;
    --auth-github) auth_github=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

select_dotfiles_profile

if [ -z "$flake" ]; then
  if [ "$profile" = personal ]; then
    flake=$personal_flake
    profile_flake_variable=DOTFILES_PERSONAL_FLAKE
  else
    flake=$work_flake
    profile_flake_variable=DOTFILES_WORK_FLAKE
  fi
fi
[ -n "$flake" ] || fail "$profile flake not set: pass --flake REF or set $profile_flake_variable"
[ "$(id -u)" -ne 0 ] || fail 'run as your normal account, not root'

resolve_dotfiles_system
resolve_dotfiles_host
ensure_darwin_command_line_tools

load_nix() {
  command -v nix >/dev/null 2>&1 && return 0
  for setup in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
               "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    # shellcheck disable=SC1090
    if [ -r "$setup" ]; then . "$setup"; break; fi
  done
  PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:$PATH"
  export PATH
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | sed 's/^.*= //'
  else
    fail 'sha256sum, shasum, or openssl is required to verify the Nix installer'
  fi
}

install_nix() {
  command -v curl >/dev/null 2>&1 || fail 'curl is required to install Determinate Nix'
  tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-bootstrap.XXXXXX") || fail 'mktemp failed'
  if [ "$os" = darwin ]; then
    log 'Downloading the signed Determinate macOS package'
    pkg="$tmp_dir/Determinate.pkg"
    curl --proto '=https' --tlsv1.2 -fsSL \
      'https://install.determinate.systems/determinate-pkg/stable/Universal' \
      -o "$pkg" || fail 'Determinate package download failed'
    assessment=$(spctl -a -vv -t install "$pkg" 2>&1) || fail "package signature rejected: $assessment"
    team=$(printf '%s\n' "$assessment" | sed -n 's/^origin=.*(\([A-Za-z0-9]*\)).*/\1/p')
    [ "$team" = 'X3JQ4VPJZ6' ] || fail "unexpected signing team: ${team:-unknown}"
    log 'Installing Determinate Nix (administrator approval required)'
    sudo /usr/sbin/installer -pkg "$pkg" -target / || fail 'macOS package installation failed'
  else
    case $(uname -m) in
      aarch64|arm64)
        installer_target=aarch64-linux
        expected_sha256=$determinate_installer_aarch64_linux_sha256
        ;;
      x86_64|amd64)
        installer_target=x86_64-linux
        expected_sha256=$determinate_installer_x86_64_linux_sha256
        ;;
      *) fail "unsupported Linux architecture: $(uname -m)" ;;
    esac

    installer="$tmp_dir/nix-installer"
    installer_url="https://github.com/DeterminateSystems/nix-installer/releases/download/v${determinate_installer_version}/nix-installer-${installer_target}"
    log "Downloading Determinate Nix installer v${determinate_installer_version} for ${installer_target}"
    curl --proto '=https' --tlsv1.2 -fsSL "$installer_url" -o "$installer" || fail 'installer download failed'
    actual_sha256=$(sha256_file "$installer")
    [ "$actual_sha256" = "$expected_sha256" ] || fail 'Determinate Nix installer checksum mismatch'
    chmod 0700 "$installer" || fail 'could not make Nix installer executable'
    "$installer" install || fail 'Determinate Nix installation failed'
  fi
}

load_nix
if ! command -v nix >/dev/null 2>&1; then
  install_nix
  load_nix
fi
command -v nix >/dev/null 2>&1 || fail 'Nix is not on PATH; open a new shell and rerun bootstrap'

if [ "$auth_github" -eq 1 ]; then
  [ -r /dev/tty ] || fail '--auth-github requires a terminal'
  printf 'GitHub token (hidden): ' >/dev/tty
  saved_stty=$(stty -g </dev/tty) || fail 'could not read terminal settings'
  stty -echo </dev/tty
  IFS= read -r token </dev/tty || { stty "$saved_stty" </dev/tty; fail 'token input failed'; }
  stty "$saved_stty" </dev/tty
  printf '\n' >/dev/tty
  [ -n "$token" ] || fail 'empty GitHub token'
  NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}
}access-tokens = github.com=$token"
  export NIX_CONFIG
  unset token
fi

if [ "$os" = darwin ]; then
  select_darwin_configuration
  attr="darwinConfigurations.\"${darwin_configuration}\""
  target="${flake}#${attr}.config.system.build.toplevel"
  selected_profile=$(nix eval --refresh --raw "${flake}#${attr}.config.profile.name") || fail 'could not evaluate configuration profile'
  expected_user=$(nix eval --refresh --raw "${flake}#${attr}.config.system.primaryUser") || fail 'could not evaluate profile account'
  expected_home=$(nix eval --refresh --raw "${flake}#${attr}.config.users.users.\"${expected_user}\".home") || fail 'could not evaluate profile home directory'
else
  config="${system}-${profile}"
  attr="homeConfigurations.\"${config}\""
  target="${flake}#${attr}.activationPackage"
  selected_profile=$(nix eval --refresh --raw "${flake}#${attr}.config.profile.name") || fail 'could not evaluate configuration profile'
  expected_user=$(nix eval --refresh --raw "${flake}#${attr}.config.home.username") || fail 'could not evaluate profile account'
  expected_home=$(nix eval --refresh --raw "${flake}#${attr}.config.home.homeDirectory") || fail 'could not evaluate profile home directory'
fi
[ "$selected_profile" = "$profile" ] || fail "configuration profile '$selected_profile' does not match selected profile '$profile'"
[ "$expected_user" = "$(id -un)" ] || fail "profile account '$expected_user' differs from current account '$(id -un)'"
[ "$expected_home" = "$HOME" ] || fail "profile home '$expected_home' differs from HOME '$HOME'"

log "Building $target"
output=$(nix build --refresh --no-link --print-out-paths "$target") || fail 'configuration build failed'
[ -x "$output/activate" ] || fail "missing activation script: $output/activate"

if [ "$os" = darwin ]; then
  command -v nix-env >/dev/null 2>&1 || fail 'nix-env is required for nix-darwin activation'
  [ -x "$output/sw/bin/darwin-rebuild" ] || fail 'built system is missing darwin-rebuild'
  log 'Activating nix-darwin system (administrator approval required)'
  sudo "$(command -v nix-env)" -p /nix/var/nix/profiles/system --set "$output" || fail 'could not update the system profile'
  sudo "$output/sw/bin/darwin-rebuild" activate || fail 'nix-darwin activation failed'
else
  log 'Activating Home Manager'
  "$output/activate" || fail 'Home Manager activation failed (inspect unmanaged file conflicts)'
fi

if [ "$os" = darwin ]; then
  printf '\nBootstrap complete: %s profile / %s configuration / %s\n' "$profile" "$darwin_configuration" "$system"
else
  printf '\nBootstrap complete: %s profile / %s\n' "$profile" "$system"
fi
printf 'Open a new terminal to use the installed environment.\n'
