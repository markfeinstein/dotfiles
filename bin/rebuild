#!/usr/bin/env bash
set -euo pipefail

profile=''
profile_from_flag=0
host=''
host_from_override=0
flake_override="${DOTFILES_FLAKE:-}"
flake_from_flag=0
personal_flake="${DOTFILES_PERSONAL_FLAKE:-}"
work_flake="${DOTFILES_WORK_FLAKE:-}"
profile_file="${DOTFILES_PROFILE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/profile}"
source_dir="${DOTFILES_SOURCE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/sources}"
source_file=''
persisted_flake=''
repo="${DOTFILES_REPO:-}"
source_mode=auto
mode=switch
dry_run=0
update_inputs=1
offline_fallback=0
no_commit=0
stage_all=0
scan_secrets=1
health_check=1
yes=0
fallback_message=0
manual_message=''
input_updates=()
nix_args=()
start_time=$(date +%s)
lock_dir=''
tmp_dir=''
profile_tmp=''
source_tmp=''
activated=no
committed=no

usage() {
  cat <<'HELP'
Usage: rebuild [switch|doctor|update|rollback] [options]

A bare `rebuild` runs switch mode.

Modes:
  switch     Update, build, commit, and activate (default)
  doctor     Evaluate prerequisites, output selection, and account identity
  update     Update, build, and commit without activation
  rollback   Activate the previous system or Home Manager generation

Selection:
  --profile personal|work  Select and persist a source/profile policy
  --host NAME              Require an exact Darwin host output
  --flake REF              Select and persist the profile's remote flake source
  --remote                 Use a remote flake source
  --local                  Use a local Git checkout
  --repo PATH              Local repository path (implies --local)
  --input NAME             Update only this input; repeat for several inputs

Workflow:
  --dry-run                Preview switch or update without changing files
  --no-update              Keep the existing flake.lock
  --offline-fallback       Continue with the previous lock after update failure
  --no-commit              Leave validated changes staged and do not commit
  --stage-all              Stage every nonignored repository path
  --no-secret-scan         Explicitly skip Gitleaks staged-content scanning
  --commit-message TEXT    Use this conventional commit subject
  --fallback-message       Permit a generic subject if Pi is unavailable
  --no-health-check        Skip the optional post-activation hook
  --yes, -y                Approve review prompts non-interactively
  --show-trace, -L         Pass Nix diagnostics to builds
  --help, -h               Show this help

Profile precedence:
  --profile, DOTFILES_PROFILE, persisted profile, interactive prompt

Darwin host precedence:
  --host, DOTFILES_HOST, macOS LocalHostName, hostname -s

Remote source precedence:
  --flake or DOTFILES_FLAKE, then DOTFILES_PERSONAL_FLAKE or
  DOTFILES_WORK_FLAKE, then the selected profile's persisted source

Environment:
  DOTFILES_PROFILE, DOTFILES_PROFILE_FILE, DOTFILES_SOURCE_DIR, DOTFILES_HOST,
  DOTFILES_FLAKE, DOTFILES_PERSONAL_FLAKE, DOTFILES_WORK_FLAKE, DOTFILES_REPO
HELP
}

fail() { printf 'rebuild: ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing required tool: $1"; }

# shellcheck source=bin/lib/profile.sh
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/lib/profile.sh"

script=${BASH_SOURCE[0]}
[[ "$script" == */* ]] || script=$(command -v "$script")
script_dir=$(cd -P "$(dirname "$script")" && pwd -P)
confirm() {
  ((yes)) && return 0
  [[ -r /dev/tty ]] || fail 'interactive approval required (or pass --yes)'
  local answer
  printf '%s [y/N] ' "$1" >/dev/tty
  IFS= read -r answer </dev/tty || fail 'no terminal input'
  [[ "$answer" == y || "$answer" == Y || "$answer" == yes || "$answer" == YES ]]
}
cleanup() {
  local status=$?
  trap - EXIT
  [[ -z "$lock_dir" ]] || rm -rf -- "$lock_dir"
  [[ -z "$tmp_dir" ]] || rm -rf -- "$tmp_dir"
  [[ -z "$profile_tmp" ]] || rm -f -- "$profile_tmp"
  [[ -z "$source_tmp" ]] || rm -f -- "$source_tmp"
  if ((status != 0)); then
    printf '\nrebuild failed (exit %s). Files and staged changes were preserved.\n' "$status" >&2
    [[ "$committed" == yes ]] && printf 'Git commit exists; activation may not have completed.\n' >&2
  fi
  printf 'Result: %s | commit: %s | activated: %s | elapsed: %ss\n' \
    "$mode" "$committed" "$activated" "$(( $(date +%s) - start_time ))"
  exit "$status"
}

persist_dotfiles_source() {
  ((flake_from_flag)) || return 0
  [[ -n "$source_file" && -n "$source_ref" ]] || fail 'cannot persist an empty flake source'
  [[ "$source_ref" != *$'\n'* && "$source_ref" != *$'\r'* ]] || fail 'flake source contains a line break'
  umask 077
  mkdir -p "$source_dir" || fail "could not create source directory: $source_dir"
  source_tmp=$(mktemp "$source_dir/$profile.tmp.XXXXXX") || fail 'could not create source temp file'
  printf '%s\n' "$source_ref" >"$source_tmp"
  chmod 600 "$source_tmp"
  mv -f "$source_tmp" "$source_file"
  source_tmp=''
}

load_dotfiles_source() {
  [[ -e "$source_file" ]] || return 0
  [[ -r "$source_file" && -f "$source_file" ]] || fail "persisted flake source is not a readable file: $source_file"
  IFS= read -r persisted_flake <"$source_file" || fail "could not read persisted flake source: $source_file"
  [[ -n "$persisted_flake" ]] || fail "persisted flake source is empty: $source_file"
  [[ -z "$(tail -n +2 "$source_file")" ]] || fail "persisted flake source has multiple lines: $source_file"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

case "${1:-}" in
  switch|doctor|update|rollback) mode=$1; shift ;;
  '') ;;
  -*) ;;
  *) fail "unknown mode: $1" ;;
esac

while (($#)); do
  case "$1" in
    --profile|--host|--flake|--repo|--input|--commit-message)
      (($# >= 2)) || fail "$1 needs a value"
      case "$1" in
        --profile) profile=$2; profile_from_flag=1 ;;
        --host) host=$2 ;;
        --flake) flake_override=$2; flake_from_flag=1 ;;
        --repo) repo=$2; source_mode=local ;;
        --input) input_updates+=("$2") ;;
        --commit-message) manual_message=$2 ;;
      esac
      shift 2 ;;
    --profile=*) profile=${1#*=}; profile_from_flag=1; shift ;;
    --host=*) host=${1#*=}; shift ;;
    --flake=*) flake_override=${1#*=}; flake_from_flag=1; shift ;;
    --repo=*) repo=${1#*=}; source_mode=local; shift ;;
    --input=*) input_updates+=("${1#*=}"); shift ;;
    --commit-message=*) manual_message=${1#*=}; shift ;;
    --remote) [[ "$source_mode" != local ]] || fail '--remote conflicts with --local/--repo'; source_mode=remote; shift ;;
    --local) [[ "$source_mode" != remote ]] || fail '--local conflicts with --remote'; source_mode=local; shift ;;
    --dry-run) dry_run=1; shift ;;
    --no-update) update_inputs=0; shift ;;
    --offline-fallback) offline_fallback=1; shift ;;
    --no-commit) no_commit=1; shift ;;
    --stage-all) stage_all=1; shift ;;
    --no-secret-scan) scan_secrets=0; shift ;;
    --no-health-check) health_check=0; shift ;;
    --fallback-message) fallback_message=1; shift ;;
    --yes|-y) yes=1; shift ;;
    --show-trace|-L|--print-build-logs) nix_args+=("$1"); shift ;;
    -h|--help) usage; trap - EXIT; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

resolve_dotfiles_system
[[ -z "$host" && -z "${DOTFILES_HOST:-}" ]] || host_from_override=1
resolve_dotfiles_host

if [[ "$mode" != rollback ]]; then
  select_dotfiles_profile
  source_file="$source_dir/$profile"
  load_dotfiles_source
elif [[ -n "$profile" || -n "${DOTFILES_PROFILE:-}" ]]; then
  select_dotfiles_profile
fi

[[ "$update_inputs" == 0 || "$update_inputs" == 1 ]] || fail 'invalid update policy'
[[ -z "${GIT_INDEX_FILE:-}" ]] || fail 'GIT_INDEX_FILE is set; refusing to modify an alternate index'
((${#input_updates[@]} == 0 || update_inputs == 1)) || fail '--input conflicts with --no-update'
if [[ "$mode" != switch && "$mode" != update && -n "$manual_message" ]]; then
  fail '--commit-message is valid only for switch or update'
fi
if [[ "$mode" != switch && "$mode" != update && ${#input_updates[@]} -gt 0 ]]; then
  fail '--input is valid only for switch or update'
fi
if [[ "$mode" != switch && "$mode" != update && $dry_run -eq 1 ]]; then
  fail '--dry-run is valid only for switch or update'
fi
((!no_commit)) || [[ -z "$manual_message" ]] || fail '--no-commit conflicts with --commit-message'

need nix

run_health_checks() {
  ((health_check)) || return 0
  local hook
  if [[ "$source_mode" == local ]]; then
    hook="$repo/nix/hooks/post-rebuild"
  else
    hook="$HOME/.config/dotfiles/post-rebuild"
  fi
  [[ -f "$hook" ]] || return 0
  [[ -x "$hook" ]] || fail "health hook is not executable: $hook"
  log 'Running optional post-activation health check'
  "$hook" || fail 'activation succeeded, but health checks failed'
}

if [[ "$mode" == rollback ]]; then
  if [[ "$os" == darwin ]]; then
    darwin_rebuild=$(command -v darwin-rebuild || true)
    [[ -n "$darwin_rebuild" ]] || darwin_rebuild=/run/current-system/sw/bin/darwin-rebuild
    [[ -x "$darwin_rebuild" ]] || fail 'darwin-rebuild is unavailable'
    need sudo
    log 'Rolling back the previous nix-darwin generation'
    sudo "$darwin_rebuild" switch --rollback || fail 'nix-darwin rollback failed'
  else
    need home-manager
    log 'Rolling back the previous Home Manager generation'
    home-manager switch --rollback || fail 'Home Manager rollback failed'
  fi
  activated=yes
  source_mode=rollback
  run_health_checks
  exit 0
fi

if [[ "$profile" == personal ]]; then
  selected_profile_flake=$personal_flake
  profile_flake_variable=DOTFILES_PERSONAL_FLAKE
else
  selected_profile_flake=$work_flake
  profile_flake_variable=DOTFILES_WORK_FLAKE
fi

persisted_repo=''
if [[ "$source_mode" == auto && -z "$repo" && -z "$flake_override" && -z "$selected_profile_flake" ]]; then
  case "$persisted_flake" in
    path:/*) persisted_repo=${persisted_flake#path:} ;;
    /*) persisted_repo=$persisted_flake ;;
  esac
  if [[ -n "$persisted_repo" && -d "$persisted_repo" && -f "$persisted_repo/flake.nix" ]] \
    && command -v git >/dev/null 2>&1; then
    persisted_repo=$(cd -P "$persisted_repo" && pwd -P)
    [[ "$(git -C "$persisted_repo" rev-parse --show-toplevel 2>/dev/null || true)" == "$persisted_repo" ]] \
      || persisted_repo=''
  else
    persisted_repo=''
  fi
fi

if [[ "$source_mode" == auto && -z "$repo" && -f "$script_dir/../flake.nix" ]]; then
  repo=$(cd -P "$script_dir/.." && pwd -P)
  source_mode=local
elif [[ "$source_mode" == auto && -n "$repo" ]]; then
  source_mode=local
elif [[ "$source_mode" == auto && -n "$persisted_repo" ]]; then
  repo=$persisted_repo
  source_mode=local
elif [[ "$source_mode" == auto ]]; then
  source_mode=remote
fi

if [[ "$source_mode" == local ]]; then
  [[ -z "$flake_override" ]] || fail '--flake is only supported in remote mode'
  if [[ -z "$repo" && -f "$script_dir/../flake.nix" ]]; then
    repo=$(cd -P "$script_dir/.." && pwd -P)
  fi
  [[ -n "$repo" ]] && repo=$(cd "$repo" && pwd -P)
  [[ -n "$repo" && -f "$repo/flake.nix" ]] || fail 'local checkout not found (use --repo PATH or --remote)'
  need git
  [[ "$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" == "$repo" ]] || fail 'not a Git repository root'
  cd "$repo"
  source_ref=$repo
else
  source_ref=$flake_override
  [[ -n "$source_ref" ]] || source_ref=$selected_profile_flake
  [[ -n "$source_ref" ]] || source_ref=$persisted_flake
  if [[ -z "$source_ref" ]]; then
    if [[ -n "$profile" ]]; then
      fail "$profile flake unknown: set $profile_flake_variable or pass --flake"
    else
      fail 'remote flake unknown: set DOTFILES_FLAKE or pass --flake'
    fi
  fi
fi

[[ "$mode" != update || "$source_mode" == local ]] || fail 'update requires --local/--repo'
[[ "$source_mode" != remote || -z "$manual_message" ]] || fail 'remote mode cannot commit'

has_darwin_configuration() {
  local wanted=$1 available
  while IFS= read -r available; do
    [[ "$available" == "$wanted" ]] && return 0
  done <<<"$darwin_configurations"
  return 1
}

select_darwin_configuration() {
  local host_configuration_profile=''
  local -a eval_args=(--raw --no-write-lock-file)
  [[ "$source_mode" != remote ]] || eval_args+=(--refresh)

  darwin_configurations=$(
    nix eval "${eval_args[@]}" "${source_ref}#darwinConfigurations" \
      --apply 'configs: builtins.concatStringsSep "\n" (builtins.attrNames configs)'
  ) || fail 'could not list nix-darwin configurations'

  if has_darwin_configuration "$host"; then
    host_configuration_profile=$(
      nix eval "${eval_args[@]}" \
        "${source_ref}#darwinConfigurations.\"${host}\".config.profile.name"
    ) || fail "could not evaluate darwinConfigurations.$host profile"
    if [[ "$host_configuration_profile" == "$profile" ]]; then
      config=$host
      return
    fi
    if ((host_from_override)); then
      fail "darwinConfigurations.$host selects the '$host_configuration_profile' profile, not '$profile'"
    fi
  elif ((host_from_override)); then
    fail "flake does not export darwinConfigurations.$host"
  fi

  if has_darwin_configuration "$profile"; then
    config=$profile
    if [[ -n "$host_configuration_profile" ]]; then
      log "Host '$host' selects the '$host_configuration_profile' profile; using the '$profile' profile configuration"
    else
      log "No configuration for host '$host'; using the '$profile' profile configuration"
    fi
  else
    fail "flake does not export a '$profile' configuration for host '$host' or profile fallback"
  fi
}

if [[ "$os" == darwin ]]; then
  select_darwin_configuration
  attr="darwinConfigurations.\"$config\""
  target="${source_ref}#${attr}.config.system.build.toplevel"
else
  config="${system}-${profile}"
  attr="homeConfigurations.\"$config\""
  target="${source_ref}#${attr}.activationPackage"
fi
printf 'Source: %s\nMode: %s / %s\nProfile: %s\nConfiguration: %s\n' \
  "$source_ref" "$source_mode" "$mode" "$profile" "$config"

validate_identity() {
  local user home selected_profile
  local -a eval_args=(--raw --no-write-lock-file)
  [[ "$source_mode" != remote ]] || eval_args+=(--refresh)
  selected_profile=$(nix eval "${eval_args[@]}" "${source_ref}#${attr}.config.profile.name") || fail 'configuration profile eval failed'
  if [[ "$os" == darwin ]]; then
    user=$(nix eval "${eval_args[@]}" "${source_ref}#${attr}.config.system.primaryUser") || fail 'profile username eval failed'
    home=$(nix eval "${eval_args[@]}" "${source_ref}#${attr}.config.users.users.\"${user}\".home") || fail 'profile home eval failed'
  else
    user=$(nix eval "${eval_args[@]}" "${source_ref}#${attr}.config.home.username") || fail 'profile username eval failed'
    home=$(nix eval "${eval_args[@]}" "${source_ref}#${attr}.config.home.homeDirectory") || fail 'profile home eval failed'
  fi
  [[ "$selected_profile" == "$profile" ]] ||
    fail "configuration profile '$selected_profile' does not match selected profile '$profile'"
  [[ "$user" == "$(id -un)" && "$home" == "$HOME" ]] ||
    fail "profile identity ($user, $home) does not match current account ($(id -un), $HOME)"
  persist_dotfiles_source
}

build_configuration() {
  log "Building $config"
  local output
  local -a build_args=(--no-write-lock-file --no-link --print-out-paths)
  [[ "$source_mode" != remote ]] || build_args+=(--refresh)
  output=$(nix build "${build_args[@]}" "${nix_args[@]}" "$target") || fail 'build failed'
  [[ -x "$output/activate" ]] || fail "activation script missing: $output/activate"
  if [[ "$os" == darwin ]]; then
    [[ -x "$output/sw/bin/darwin-rebuild" ]] || fail 'built system is missing darwin-rebuild'
  fi
  built_output=$output
}

activate_configuration() {
  if [[ "$os" == darwin ]]; then
    local nix_env
    nix_env=$(command -v nix-env) || fail 'nix-env is required for nix-darwin activation'
    need sudo
    log 'Activating nix-darwin system'
    sudo "$nix_env" -p /nix/var/nix/profiles/system --set "$built_output" || fail 'could not update the system profile'
    sudo "$built_output/sw/bin/darwin-rebuild" activate || fail 'nix-darwin activation failed'
  else
    log 'Activating Home Manager configuration'
    "$built_output/activate" || fail 'Home Manager activation failed'
  fi
  activated=yes
}

if [[ "$mode" == doctor ]]; then
  printf 'Nix: %s\n' "$(nix --version)"
  if [[ "$source_mode" == local ]]; then
    printf 'Git: %s\n' "$(git --version)"
    if command -v pi >/dev/null 2>&1; then
      printf 'Pi: available\n'
    else
      printf 'Pi: missing (only required for generated commits)\n'
    fi
  fi
  validate_identity
  log 'Selected configuration output evaluates successfully'
  exit 0
fi

if ((dry_run)); then
  [[ "$source_mode" != local ]] || git status --short --untracked-files=all
  if [[ "$source_mode" == local ]]; then
    printf 'Would stage managed paths, scan, format, update inputs, build, and commit.\n'
  else
    printf 'Would validate and build the selected remote configuration.\n'
  fi
  [[ "$mode" != switch ]] || printf 'Would activate the exact built output.\n'
  exit 0
fi

if [[ "$source_mode" == remote ]]; then
  validate_identity
  build_configuration
  [[ "$mode" != switch ]] || activate_configuration
  [[ "$mode" != switch ]] || run_health_checks
  exit 0
fi

need git
if [[ -n "$(git status --porcelain=v1 --untracked-files=all -- .git 2>/dev/null)" ]]; then
  fail 'unexpected Git metadata state'
fi
for state in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD; do
  [[ ! -f "$(git rev-parse --git-path "$state")" ]] || fail "unfinished Git operation: $state"
done
if [[ -d "$(git rev-parse --git-path rebase-merge)" || -d "$(git rev-parse --git-path rebase-apply)" ]]; then
  fail 'unfinished Git rebase'
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-rebuild.XXXXXX") || fail 'mktemp failed'
git_dir=$(git rev-parse --absolute-git-dir)
lock_dir="$git_dir/dotfiles-rebuild.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  if [[ -f "$lock_dir/pid" ]]; then
    old_pid=$(cat "$lock_dir/pid")
    if [[ "$old_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$old_pid" 2>/dev/null; then
      rm -rf -- "$lock_dir"
      mkdir "$lock_dir" || fail 'another rebuild acquired the lock'
    else
      fail "rebuild already running (PID $old_pid)"
    fi
  else
    fail "lock directory already exists: $lock_dir (inspect before removing)"
  fi
fi
printf '%s\n' "$$" >"$lock_dir/pid"

managed_scopes=(
  .github
  .pi
  agents
  bin
  config
  nix
  nvim
  openlogi
  rex
  themes
  flake.nix
  flake.lock
  README.md
)

managed_path() {
  local scope
  for scope in "${managed_scopes[@]}"; do
    if [[ "$1" == "$scope" || "$1" == "$scope/"* ]]; then
      return 0
    fi
  done
  return 1
}

check_index_safety() {
  local path
  if ((!stage_all)); then
    while IFS= read -r -d '' path; do
      managed_path "$path" || fail "staged file is outside managed paths: $path (use --stage-all)"
    done < <(git diff --cached --name-only -z)
  fi
  # stage_changes intentionally promotes managed files to their complete working
  # tree state before review, including a partially staged flake.lock left by a
  # previous interrupted update.
}

stage_changes() {
  if ((stage_all)); then
    git add -A
  else
    local -a scopes=()
    local path
    for path in "${managed_scopes[@]}"; do
      if [[ -e "$path" || -n "$(git ls-files -- "$path")" ]]; then
        scopes+=("$path")
      fi
    done
    ((${#scopes[@]} == 0)) || git add -A -- "${scopes[@]}"
  fi
}

check_sensitive_names() {
  local path
  while IFS= read -r -d '' path; do
    case "${path##*/}" in
      .env|.env.*|id_rsa|id_ed25519|*.pem|*.p12|*.pfx|*.key|credentials.json|secrets.json)
        [[ "${path##*/}" == .env.example ]] || fail "sensitive filename staged: $path" ;;
    esac
  done < <(git diff --cached --name-only -z)
}

tool_path() {
  local name=$1 path=''
  path=$(nix build --no-link --print-out-paths --inputs-from "$repo" "nixpkgs#$name" 2>/dev/null) || path=''
  if [[ -n "$path" && -x "$path/bin/$name" ]]; then
    printf '%s\n' "$path/bin/$name"
    return 0
  fi
  path=$(nix build --no-link --print-out-paths "github:NixOS/nixpkgs/nixos-26.05#$name" 2>/dev/null) || path=''
  if [[ -n "$path" && -x "$path/bin/$name" ]]; then
    printf '%s\n' "$path/bin/$name"
    return 0
  fi
  command -v "$name" || return 1
}

scan_index() {
  ((scan_secrets)) || return 0
  local gitleaks config
  config="$repo/.gitleaks.toml"
  if [[ -e "$config" || -L "$config" ]]; then
    [[ -r "$config" && -f "$config" ]] || fail "Gitleaks configuration is not a readable file: $config"
  else
    config="$tmp_dir/gitleaks-default.toml"
    if [[ ! -f "$config" ]]; then
      cat >"$config" <<'EOF'
title = "Default rebuild secret scanning policy"

[extend]
useDefault = true
EOF
    fi
  fi
  gitleaks=$(tool_path gitleaks) || fail 'Gitleaks unavailable (or pass --no-secret-scan)'
  "$gitleaks" git --staged --config "$config" --redact --exit-code 1 . \
    || fail 'secrets detected or Gitleaks failed'
}

review_index() {
  local purpose=$1
  log "$purpose"
  git status --short --untracked-files=all
  if ! git diff --cached --quiet; then
    git --no-pager diff --cached --no-ext-diff
    confirm "Approve the above staged changes for $purpose?" || fail 'review declined'
  fi
}

format_nix() {
  local nixfmt file
  nixfmt=$(tool_path nixfmt) || fail 'nixfmt unavailable'
  log 'Formatting Nix files'
  while IFS= read -r -d '' file; do
    [[ -f "$file" && ! -L "$file" ]] || continue
    "$nixfmt" "$file" || fail "could not format $file"
  done < <(git ls-files -z -c -o --exclude-standard -- '*.nix')
}

update_lock() {
  ((update_inputs)) || return 0
  local saved="$tmp_dir/flake.lock.before" had_lock=0
  if [[ -f flake.lock ]]; then
    cp flake.lock "$saved"
    had_lock=1
  fi
  log 'Updating flake inputs'
  if ((${#input_updates[@]})); then
    update_command=(nix flake update "${input_updates[@]}")
  else
    update_command=(nix flake update)
  fi
  if "${update_command[@]}"; then
    return 0
  fi
  if ((had_lock)); then cp "$saved" flake.lock; else rm -f flake.lock; fi
  stage_changes
  if ((offline_fallback)) || confirm 'Input update failed. Continue with the previous lockfile?'; then
    log 'Using previous flake.lock'
  else
    fail 'flake update failed'
  fi
}

commit_index() {
  git diff --cached --quiet && return 0
  local subject=$manual_message pi_output diff_file
  if [[ -z "$subject" ]] && command -v pi >/dev/null 2>&1; then
    confirm 'Send the approved staged patch to Pi for a commit subject?' || fail 'Pi review declined'
    diff_file="$tmp_dir/commit.diff"
    git diff --cached --no-ext-diff -- . ':(exclude)flake.lock' >"$diff_file"
    if pi_output=$(head -c 60000 "$diff_file" | pi --print --no-session --no-tools \
        --no-extensions --no-skills --no-context-files \
        'Generate exactly one concise conventional commit subject (type(scope): description). No markdown or explanation.'); then
      subject=$(printf '%s\n' "$pi_output" | sed -n '1p')
    fi
  fi
  if [[ -z "$subject" ]]; then
    if ((fallback_message)) || confirm 'Pi unavailable. Use "chore(dotfiles): update configuration"?'; then
      subject='chore(dotfiles): update configuration'
    else
      fail 'no commit message available'
    fi
  fi
  local pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9.-]+\))?!?: .+'
  [[ "$subject" =~ $pattern ]] || fail "not a conventional commit subject: $subject"
  git commit -m "$subject" || fail 'Git commit failed'
  committed=yes
}

check_index_safety
log 'Reviewing sources before Nix reads them'
stage_changes
check_sensitive_names
review_index 'Initial review'
scan_index
format_nix
stage_changes
update_lock
stage_changes
check_sensitive_names
scan_index
validate_identity
build_configuration
git diff --cached --check || fail 'staged whitespace errors'
review_index 'Final pre-commit review'
if ((!no_commit)); then
  commit_index
fi
if [[ "$mode" == update ]]; then
  exit 0
fi
activate_configuration || fail 'activation failed (commit, if created, was preserved)'
run_health_checks
