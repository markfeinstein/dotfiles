#!/usr/bin/env bash

set -euo pipefail

repo_root=${HOME_AUTOMATION_REPO_ROOT:-"$HOME/dev/home-automation"}
canonical_repo_root=
worktree_root=
# shellcheck source=bin/lib/worktrees.sh
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/lib/worktrees.sh"
prepare_worktree_context "$repo_root" \
  "Refusing to provision Pi MCP config outside home-automation" \
  "Skipping Pi MCP config outside home-automation worktree root"
canonical_pi_dir="$canonical_repo_root/.pi"

link_path="$worktree_root/.pi"
if [[ -L $link_path ]]; then
  link_target="$(readlink "$link_path")"
  if [[ $link_target == "$canonical_pi_dir" ]]; then
    exit 0
  fi
  echo "Refusing to replace existing .pi symlink at $link_path" >&2
  exit 1
fi

if [[ -e $link_path ]]; then
  echo "Refusing to replace existing .pi path at $link_path" >&2
  exit 1
fi

if [[ ! -d $canonical_pi_dir ]]; then
  echo "Refusing to create .pi symlink before canonical Pi directory exists" >&2
  exit 1
fi

ln -s "$canonical_pi_dir" "$link_path"
